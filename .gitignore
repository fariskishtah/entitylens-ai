__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
.pytest_cache/
.ipynb_checkpoints/
*.log

# Large raw downloads (GloVe zip + txt) — regenerated by scripts/embeddings
data/raw/*
!data/raw/.gitkeep
# cached embedding matrices (regenerable from GloVe + vocab)
data/processed/emb_*.npy

# CoNLL-2003 corpus tokens/labels are NOT redistributed here (Reuters licensing).
# Regenerate the frozen splits locally with `python scripts/prepare_data.py`.
data/processed/*.parquet
# Derived statistics + provenance (checksums, counts) are safe to publish.
!data/processed/data_audit.json
!data/processed/dataset_provenance.json

# Trained checkpoints come from training runs / releases, not source control.
artifacts/*
!artifacts/.gitkeep

# Kaggle local scratch
artifacts_kaggle/
kernel-output/
deploy/space/
